# Linux udev rules for Redragon M719RGB-PRO (INVADER PRO)
# Copy this file to /etc/udev/rules.d/99-redragon-m719-pro.rules
# Then run: sudo udevadm control --reload-rules && sudo udevadm trigger

# Redragon M719RGB-PRO 2.4G Wireless Receiver (VID 0x25A7, PID 0xFA7E)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="25a7", ATTRS{idProduct}=="fa7e", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="25a7", ATTRS{idProduct}=="fa7e", MODE="0666", TAG+="uaccess"

# Redragon M719RGB-PRO Wired USB Mode (VID 0x25A7, PID 0xFAB0)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="25a7", ATTRS{idProduct}=="fab0", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="25a7", ATTRS{idProduct}=="fab0", MODE="0666", TAG+="uaccess"
